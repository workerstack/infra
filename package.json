{
  "name": "workerstack-infra",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "postinstall": "repo sync --postinstall",
    "lint": "repo lint",
    "fmt": "repo fmt",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "ci": "repo ci"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@workerstack/repo": "0.2.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
